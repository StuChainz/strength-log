    "expo": "~54.0.35",
    "expo-application": "~7.0.8",
    "expo-clipboard": "~8.0.8",
    "expo-device": "~8.0.10",
    "expo-font": "~14.0.12",
    "expo-notifications": "~0.32.17",
    "expo-sqlite": "^16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
