    "@types/react": "~19.1.17",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.9.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "^3.4.0",
